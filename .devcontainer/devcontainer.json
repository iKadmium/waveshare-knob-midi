{
	"name": "ESP32 Rust Environment",
	"image": "espressif/idf-rust:esp32s3_latest",
	"remoteUser": "esp",
	"features": {},
	"customizations": {
		"vscode": {
			"extensions": [
				"rust-lang.rust-analyzer",
				"serayuzgur.crates",
				"tamasfe.even-better-toml",
				"mutantdino.resourcemonitor"
			],
			"settings": {
				"rust-analyzer.check.command": "clippy"
			}
		}
	},
	"mounts": [
		//"source=/run/udev,target=/run/udev,type=bind,readonly"
	],
	"runArgs": [
		"--privileged"
	]
}